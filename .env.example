# ===========================================================================
# VíaRescate VE — Variables de entorno
# ===========================================================================
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env a Git.
# ===========================================================================

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=cambia-esto-por-un-token-de-64-caracteres
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://viarescate-ve.vercel.app

# ---------------------------------------------------------------------------
# Base de datos — Supabase (PostgreSQL + PostGIS)
# ---------------------------------------------------------------------------
# Opción recomendada: una sola URL con scheme postgis://
# DATABASE_URL=postgis://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
#
# Opción alternativa (variables separadas, sin query params):
SUPABASE_DB_HOST=aws-0-<REGION>.pooler.supabase.com
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<PROJECT_REF>
SUPABASE_DB_PASSWORD=<TU_PASSWORD>
SUPABASE_DB_PORT=6543

# ---------------------------------------------------------------------------
# Supabase Storage (para fotografías de reportes)
# ---------------------------------------------------------------------------
# Activar solo si tienes el bucket configurado.
# Las claves S3 se obtienen en Supabase → Storage → S3 Connection.
USE_S3_MEDIA=False
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_BUCKET=media
SUPABASE_S3_ENDPOINT=https://<PROJECT_REF>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_PUBLIC_URL=https://<PROJECT_REF>.supabase.co/storage/v1/object/public/media/

# ---------------------------------------------------------------------------
# Localización
# ---------------------------------------------------------------------------
TIME_ZONE=America/Caracas
LANGUAGE_CODE=es-ve

# ---------------------------------------------------------------------------
# Redis / Celery (no se ejecuta en Vercel; dejar vacío en producción)
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
