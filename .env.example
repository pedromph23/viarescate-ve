# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-this-secret-key
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Opción A (recomendada en producción): una sola URL
# DATABASE_URL=postgis://usuario:password@host:puerto/nombre
#
# Opción B (útil en desarrollo local): variables separadas
DB_NAME=viarescate_ve
DB_USER=viarescate
DB_PASSWORD=change-this-password
DB_HOST=127.0.0.1
DB_PORT=5432

# ---------------------------------------------------------------------------
# Redis / Celery (no se ejecuta en Vercel)
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------------------
# Localización
# ---------------------------------------------------------------------------
TIME_ZONE=America/Caracas
LANGUAGE_CODE=es-ve

# ---------------------------------------------------------------------------
# Supabase Storage (opcional; activar con USE_S3_MEDIA=True)
# ---------------------------------------------------------------------------
USE_S3_MEDIA=False
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_BUCKET=media
SUPABASE_S3_ENDPOINT=https://[ref].supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_PUBLIC_URL=https://[ref].supabase.co/storage/v1/object/public/media/
